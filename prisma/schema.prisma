generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  email         String?    @unique
  password      String?
  // age           Int?       @default(0)
  fullName      String?    @default("")
  shopAddress      String?    @default("")
  shopName      String?    @default("")
  profileImage  String?    @default("")
  phone         String?    @default("")
  otp           Int?       @default(0)
  role          UserRole   @default(USER)
  otpExpiresAt  DateTime?  @default(now())
  status        UserStatus @default(ACTIVE)
  gender        Gender     @default(Male)
  isOnline      Boolean    @default(false)
  isVerifyEmail Boolean    @default(false)
  adminReq      AdminReq   @default(PENDING)
  isDeleted     Boolean    @default(false)

  isNotificationOn Boolean @default(false)
  isUserOnline     Boolean @default(false)
  fcmToken         String? @default("")

  accountLink           String?   @default("")
  stripeAccountUrl      String?   @default("")
  stripeAccountId       String?   @default("")
  stripeCustomerId      String?   @default("")
  isSubscribed          Boolean   @default(false)
  planId                String?   @db.ObjectId
  plan                  SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptionExpiresAt DateTime?
  isTrialUsed           Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  Notification Notification[]
  Payment      Payment[]

  @@map("users")
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  data      String?
  targetId  String?          @default("")
  // targetId  String?          @db.ObjectId
  slug      String?          @default("")
  fcmToken  String?          @default("")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // target    User?            @relation("ReceivedNotifications", fields: [targetId], references: [id], onDelete: Cascade)
  @@map("notifications")
}

enum NotificationType {
  GENERAL
  LOGIN_SUCCESS
  ORDER_PLACED
  NEW_ORDER
  UPDATE_PROFILE
  REGISTRATION
  PASSWORD_RESET
  NEW_CHAT_MESSAGE
}

enum UserRole {
  USER
  ADMIN
}

enum AdminReq {
  APPROVED
  PENDING
  DECLINED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Gender {
  Male
  Female
  Other
}

// সাবস্ক্রিপশন প্ল্যান মডেল
model SubscriptionPlan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique // e.g. "Free Plan", "Monthly Plan", "Yearly Plan"
  price     Float    // e.g. 0, 899, 2499
  currency  String   @default("USD")
  duration        String? // e.g. "monthly", "yearly"
  technicianLimit Int     @default(0) // e.g. 3, 5
  hasTrial        Boolean @default(false) // Only for Professional Shop Plan
  features        String[] // Array of strings e.g. ["Full access...", "Powerful keyword search..."]
  isPopular Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User    User[]
  Payment Payment[]

  @@map("subscription_plans")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  userId        String           @db.ObjectId
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String           @db.ObjectId
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount        Float
  status        PaymentStatus    @default(PENDING)
  transactionId String?          @unique
  invoiceId     String?          @default("")
  subscriptionId String?         @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("payments")
}