generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  email         String?    @unique
  password      String?
  // age           Int?       @default(0)
  fullName      String?    @default("")
  shopAddress   String?    @default("")
  shopName      String?    @default("")
  profileImage  String?    @default("")
  phone         String?    @default("")
  otp           Int?       @default(0)
  role          UserRole   @default(USER)
  otpExpiresAt  DateTime?  @default(now())
  status        UserStatus @default(ACTIVE)
  gender        Gender     @default(Male)
  isOnline      Boolean    @default(false)
  isVerifyEmail Boolean    @default(false)
  adminReq      AdminReq   @default(PENDING)
  isDeleted     Boolean    @default(false)

  isNotificationOn Boolean @default(false)
  isUserOnline     Boolean @default(false)
  fcmToken         String? @default("")
  passkey          String? @default("")
  totalSessions    Int     @default(0)

  accountLink           String?           @default("")
  stripeAccountUrl      String?           @default("")
  stripeAccountId       String?           @default("")
  stripeCustomerId      String?           @default("")
  isSubscribed          Boolean           @default(false)
  planId                String?           @db.ObjectId
  plan                  SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptionExpiresAt DateTime?
  isTrialUsed           Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Multi-plan relations
  planSubscriptions UserPlanSubscription[] @relation("OwnerSubscriptions")

  ownerId     String? @db.ObjectId
  owner       User?   @relation("ShopTechnicians", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  technicians User[]  @relation("ShopTechnicians")

  Notification Notification[]
  Payment      Payment[]
  diagnostics         Diagnostic[] @relation("TechnicianDiagnostics")
  managedDiagnostics  Diagnostic[] @relation("OwnerDiagnostics")

  @@map("users")
}

model Diagnostic {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  technicianId String   @db.ObjectId
  technician   User     @relation("TechnicianDiagnostics", fields: [technicianId], references: [id])
  ownerId      String   @db.ObjectId
  owner        User     @relation("OwnerDiagnostics", fields: [ownerId], references: [id])
  persona      String   // Shop Foreman, Mechanical, Electrical, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("diagnostics")
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  data      String?
  targetId  String?          @default("")
  // targetId  String?          @db.ObjectId
  slug      String?          @default("")
  fcmToken  String?          @default("")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // target    User?            @relation("ReceivedNotifications", fields: [targetId], references: [id], onDelete: Cascade)
  @@map("notifications")
}

enum NotificationType {
  GENERAL
  LOGIN_SUCCESS
  ORDER_PLACED
  NEW_ORDER
  UPDATE_PROFILE
  REGISTRATION
  PASSWORD_RESET
  NEW_CHAT_MESSAGE
}

enum UserRole {
  USER
  ADMIN
  TECHNICIAN
}

enum AdminReq {
  APPROVED
  PENDING
  DECLINED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  INVITED
  SUSPENDED
}

enum Gender {
  Male
  Female
  Other
}

// Subscription Plan Model
enum PlanCategory {
  BASIC
  PROFESSIONAL
  EUROPEAN
}

enum PlanDuration {
  Monthly
  Annually
}

type PlanPrice {
  duration PlanDuration
  price    Float
}

model SubscriptionPlan {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  category        PlanCategory @unique // Category is unique again
  name            String       @default("") // Human-readable name (e.g. "Basic Shop Plan")
  description     String       @default("") // Marketing description text
  currency        String       @default("USD") // Default currency
  prices          PlanPrice[] // Nested pricing options
  technicianLimit Int // e.g. 3, 5
  hasTrial        Boolean      @default(false)
  features        String[] // Array of strings
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  User              User[]
  Payment           Payment[]
  // Relation to individual subscriptions
  planSubscriptions UserPlanSubscription[] @relation("PlanSubscriptions")

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
  incomplete
  incomplete_expired
}

// Independent plan bucket for technician slot tracking
model UserPlanSubscription {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  ownerId              String             @db.ObjectId
  owner                User               @relation("OwnerSubscriptions", fields: [ownerId], references: [id])
  planId               String             @db.ObjectId
  plan                 SubscriptionPlan   @relation("PlanSubscriptions", fields: [planId], references: [id])
  duration             PlanDuration
  status               SubscriptionStatus @default(active)
  expiresAt            DateTime?
  stripeSubscriptionId String?            @unique @default("")
  technicianIds        String[]           @default([]) // Technician user IDs assigned to this plan
  autoRenew            Boolean            @default(true)
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("user_plan_subscriptions")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  userId         String           @db.ObjectId
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String           @db.ObjectId
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount         Float
  duration       PlanDuration? // Field added to track chosen duration
  status         PaymentStatus    @default(PENDING)
  transactionId  String?          @unique
  invoiceId      String?          @default("")
  subscriptionId String?          @default("")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("payments")
}
